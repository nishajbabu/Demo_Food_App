{
  "expo": {
    "name": "GaonGo Partner",
    "slug": "gaongo-partner",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "gaongopartner",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.gaongo.partner"
    },
    "android": {
      "package": "in.gaongo.partner",
      "adaptiveIcon": {
        "backgroundColor": "#1F2933",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GaonGo Partner uses your location while you are online so we can send you nearby deliveries and rides."
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2a5b03d6-0a22-4173-a265-c6db19dbdaf5"
      }
    },
    "owner": "nishajbabu"
  }
}
