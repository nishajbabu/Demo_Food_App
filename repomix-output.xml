          </>
        ) : (
          <>
            <Muted>We sent a code to {phone}.</Muted>
            {devOtp ? (
              <View style={{ backgroundColor: colors.marigoldTint, padding: 12, borderRadius: 12 }}>
                <Text style={{ fontWeight: '700' }}>Test mode: your code is {devOtp}</Text>
              </View>
