// Runtime switches stored in the database (changed from the admin console, no app update needed).
import { one, query } from '../db.js';
import { forbidden } from '../middleware/errors.js';

export const DEFAULT_SERVICES = { grocery: true, milk: true, food: false, rides: false };

export async function getServices() {
  const row = await one("SELECT value FROM settings WHERE key = 'services'");
  return { ...DEFAULT_SERVICES, ...(row?.value || {}) };
}

export async function setServices(patch) {
  const next = { ...(await getServices()), ...patch };
  await query(
    `INSERT INTO settings (key, value) VALUES ('services', $1)
     ON CONFLICT (key) DO UPDATE SET value = EXCLUDED.value`,
    [JSON.stringify(next)],
  );
  return next;
}

export async function requireService(name) {
  const services = await getServices();
  if (!services[name]) throw forbidden(`${name[0].toUpperCase() + name.slice(1)} is not available in your area yet`);
}
</file>

<file path="backend/src/lib/sms.js">
// Sending SMS (login codes) and alerts.
//
// SMS_PROVIDER=console  -> prints the message in the server window (development only).
// SMS_PROVIDER=http     -> sends JSON to SMS_HTTP_URL. Most Indian SMS providers accept a
//                          JSON POST; change the body below to match the one you choose.
//                          Remember: Indian SMS needs a DLT-registered sender ID and template.
import { config } from '../config.js';

export async function sendSms(phone, message) {
  const { provider, httpUrl, httpToken, senderId } = config.sms;
  if (provider === 'console') {
    if (config.env !== 'test') console.log(`\n[SMS to ${phone}] ${message}\n`);
    return;
  }
  if (provider === 'http') {
    const res = await fetch(httpUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${httpToken}` },
      body: JSON.stringify({ to: `+91${phone}`, message, sender: senderId }),
    });
    if (!res.ok) throw new Error(`SMS provider returned ${res.status}`);
    return;
  }
  throw new Error(`Unknown SMS_PROVIDER "${provider}"`);
}

// Alerts to shops, riders and customers. Today these are only logged; the apps pick up
// changes by asking the server every few seconds. Next step (milestone M3): send a push
// notification here with Expo Push or Firebase Cloud Messaging so phones ring even when
// the app is closed.
export function notify(userId, message) {
  if (config.env !== 'test') console.log(`[notify user ${userId}] ${message}`);
}
</file>

<file path="backend/src/lib/time.js">
// Dates are always worked out in India time, whatever timezone the server runs in.
// A "date" here is a plain string like "2026-11-21".

const dayFormat = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Kolkata',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const hourFormat = new Intl.DateTimeFormat('en-GB', { timeZone: 'Asia/Kolkata', hour: '2-digit', hourCycle: 'h23' });

export const todayIST = () => dayFormat.format(new Date());
export const hourIST = () => parseInt(hourFormat.format(new Date()), 10);

export function addDays(date, n) {
  const d = new Date(`${date}T00:00:00Z`);
  d.setUTCDate(d.getUTCDate() + n);
  return d.toISOString().slice(0, 10);
}

export const daysBetween = (a, b) => Math.round((Date.parse(`${b}T00:00:00Z`) - Date.parse(`${a}T00:00:00Z`)) / 864e5);
export const weekday = (date) => new Date(`${date}T00:00:00Z`).getUTCDay(); // 0 = Sunday

// '2026-11' -> ['2026-11-01', '2026-11-30']
export function monthRange(month) {
  const first = `${month}-01`;
  const d = new Date(`${first}T00:00:00Z`);
  d.setUTCMonth(d.getUTCMonth() + 1);
  d.setUTCDate(0);
  return [first, d.toISOString().slice(0, 10)];
}

export const thisMonth = () => todayIST().slice(0, 7);
</file>

