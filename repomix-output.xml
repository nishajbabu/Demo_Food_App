<file path="backend/scripts/migrate.js">
// Creates all tables from db/schema.sql.
//   npm run db:migrate          -> create anything missing (safe, keeps data)
//   npm run db:reset            -> DELETE EVERYTHING and start fresh (refuses in production)
import fs from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { config } from '../src/config.js';
import { createPool } from '../src/db.js';

const here = path.dirname(fileURLToPath(import.meta.url));
const schema = fs.readFileSync(path.join(here, '..', 'db', 'schema.sql'), 'utf8');

export async function migrate({ url = config.databaseUrl, reset = false } = {}) {
  const pool = createPool(url);
  try {
    if (reset) {
      if (config.isProduction) throw new Error('Refusing to reset a production database');
      await pool.query('DROP SCHEMA public CASCADE; CREATE SCHEMA public;');
    }
    await pool.query(schema);
  } finally {
    await pool.end();
  }
}

if (process.argv[1] === fileURLToPath(import.meta.url)) {
  const reset = process.argv.includes('--reset');
  migrate({ reset })
    .then(() => console.log(reset ? 'Database wiped and tables created.' : 'Tables are up to date.'))
    .catch((err) => {
      console.error('Migration failed:', err.message);
      process.exit(1);
    });
}
</file>

<file path="backend/src/lib/geo.js">
// Distance between two points on Earth ("as the crow flies"), in km.
export function haversineKm(a, b) {
  if (a?.lat == null || b?.lat == null) return null;
  const R = 6371;
  const rad = (x) => (x * Math.PI) / 180;
  const dLat = rad(b.lat - a.lat);
  const dLng = rad(b.lng - a.lng);
  const h = Math.sin(dLat / 2) ** 2 + Math.cos(rad(a.lat)) * Math.cos(rad(b.lat)) * Math.sin(dLng / 2) ** 2;
  return 2 * R * Math.asin(Math.sqrt(h));
}

// Village roads are not straight: multiply by a road factor and round to 0.1 km.
export function roadKm(a, b, factor = 1.3) {
  const km = haversineKm(a, b);
  return km == null ? null : Math.max(0.5, Math.round(km * factor * 10) / 10);
}
</file>

<file path="backend/src/lib/payments.js">
// Online UPI payments through Razorpay Payment Links.
// How it works: we ask Razorpay for a payment link, the app opens it, the customer pays
// with any UPI app, and Razorpay calls our webhook to say "paid".
// Check the request fields against Razorpay's current API docs before going live.
import crypto from 'node:crypto';
import { config } from '../config.js';

export const upiEnabled = () => Boolean(config.razorpay.keyId && config.razorpay.keySecret);

export async function createPaymentLink({ amountPaise, referenceId, description, customerPhone, customerName }) {
  const { keyId, keySecret } = config.razorpay;
  const auth = Buffer.from(`${keyId}:${keySecret}`).toString('base64');
  const res = await fetch('https://api.razorpay.com/v1/payment_links', {
    method: 'POST',
    headers: { Authorization: `Basic ${auth}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({
      amount: amountPaise,
      currency: 'INR',
      reference_id: referenceId,
      description,
      customer: { name: customerName || 'GaonGo customer', contact: `+91${customerPhone}` },
      notify: { sms: true },
      reminder_enable: false,
    }),
  });
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(`Razorpay error ${res.status}: ${data?.error?.description || 'unknown'}`);
  return { id: data.id, url: data.short_url };
}

export function verifyWebhookSignature(rawBody, signature) {
  if (!config.razorpay.webhookSecret || !signature) return false;
  const expected = crypto.createHmac('sha256', config.razorpay.webhookSecret).update(rawBody).digest('hex');
  const a = Buffer.from(expected);
  const b = Buffer.from(String(signature));
  return a.length === b.length && crypto.timingSafeEqual(a, b);
}
</file>

