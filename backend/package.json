{
  "name": "gaongo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "GaonGo API server: orders, subscriptions, rides, support and admin for a rural super app.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "start:prod": "node scripts/migrate.js && node src/server.js",
    "db:local": "node scripts/local-db.js",
    "db:setup": "node scripts/migrate.js && node db/seed.js",
    "db:migrate": "node scripts/migrate.js",
    "db:reset": "node scripts/migrate.js --reset && node db/seed.js",
    "deliveries:generate": "node scripts/generate-deliveries.js",
    "test": "node --test --test-concurrency=1 test/flows.test.js",
    "admin:create": "node scripts/create-admin.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  },
  "optionalDependencies": {
    "embedded-postgres": "^17.2.0-beta.15"
  }
}
