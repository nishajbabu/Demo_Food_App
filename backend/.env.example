# ------------------------------------------------------------------
# GaonGo backend settings.
# Copy this file to ".env" and change the values. Never commit .env to GitHub.
# ------------------------------------------------------------------

# development | production   (production turns on the safety checks in src/config.js)
NODE_ENV=development
PORT=4000

# Where the database lives.
#  - Local database started with "npm run db:local":
DATABASE_URL=postgres://postgres:gaongo@localhost:5433/gaongo
#  - A cloud database (Neon, Supabase, Render...) looks like:
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_SSL=true

# Database used by "npm test". Its name MUST end with _test because the tests wipe it.
TEST_DATABASE_URL=postgres://postgres:gaongo@localhost:5433/gaongo_test

# Long random secret used to sign login tokens. In production use 40+ random characters.
JWT_SECRET=dev-only-change-me

# OTP login. In development the code is printed in the server window AND returned to the
# app, so you can log in without a real SMS. MUST be false in production.
OTP_DEV_MODE=true

# SMS: "console" just prints. "http" posts {to, message, sender} as JSON to SMS_HTTP_URL
# with "Authorization: Bearer SMS_HTTP_TOKEN" - adapt src/lib/sms.js to your provider.
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
SMS_SENDER_ID=GAONGO

# Online UPI payments through Razorpay Payment Links (leave empty to accept cash only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Money rules, in paise (100 paise = Rs 1)
DELIVERY_FEE_PAISE=2000
FREE_DELIVERY_ABOVE_PAISE=19900
RIDER_PAY_PER_DELIVERY_PAISE=3500
DRIVER_DAILY_PASS_PAISE=2500
REQUIRE_DRIVER_PASS=false

# Shown inside the apps on the Help screen
SUPPORT_PHONE=
SUPPORT_WHATSAPP=

# Which websites may call the API from a browser (the admin console). * = any.
CORS_ORIGINS=*
